<Project>

  <!--
    全解决方案共享的编译设置。
    设计依据：EasiLoginer-CSharp-重构框架.md §4.4「命名与代码约定」。
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- 文档要求零警告交付；任何警告都视为构建失败 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-minimum</AnalysisLevel>

    <Deterministic>true</Deterministic>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <NeutralLanguage>zh-Hans</NeutralLanguage>

    <!--
      不要把 git 提交哈希塞进 InformationalVersion：
      界面（关于页）与更新检查（PEP 440 解析）都把它当纯版本号用。
    -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- 中文优先：源码与资源统一 UTF-8 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);.cache/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- 版权与品牌（GPLv3 衍生作品，保留上游归属见 NOTICE） -->
  <PropertyGroup>
    <Company>SurinChi</Company>
    <Product>EasiLoginer</Product>
    <Authors>SurinChi</Authors>
    <Copyright>Copyright (C) 2026 SurinChi</Copyright>

    <!-- 版本号由 SurinChi 维护：0.0.1 为首发，0.0.2 起走正常迭代 -->
    <Version>0.0.4</Version>
    <AssemblyVersion>0.0.4.0</AssemblyVersion>
    <FileVersion>0.0.4.0</FileVersion>
    <InformationalVersion>0.0.4</InformationalVersion>
  </PropertyGroup>

</Project>
