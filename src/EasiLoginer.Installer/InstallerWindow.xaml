<Window x:Class="EasiLoginer.Installer.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasiLoginer 安装向导"
        Width="680" Height="500"
        MinWidth="680" MinHeight="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F7F7F8"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Image Width="44" Height="44" Source="Assets/easiloginer.png"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="EasiLoginer 安装向导" FontSize="21" FontWeight="SemiBold" />
                <TextBlock x:Name="SubtitleText" Opacity="0.68" Margin="0,3,0,0"
                           Text="第 1 步，共 3 步 · 选择安装位置" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">

            <!-- 第 1 步：许可与目录 -->
            <Grid x:Name="LicenseStep">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" TextWrapping="Wrap" Opacity="0.85"
                           Text="本程序以 GNU General Public License v3.0 发布，按「现状」提供，不附带任何担保。安装前请阅读以下要点：" />
                <Border Grid.Row="1" Margin="0,10,0,0" Padding="12" CornerRadius="6" Background="White"
                        BorderBrush="#E3E3E6" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock TextWrapping="Wrap" LineHeight="20" Opacity="0.82">
                            <Run Text="• 登录只在你手动触发时执行，不会定时或由外部事件自动启动。" /><LineBreak /><LineBreak />
                            <Run Text="• 账号与密码保存在安装目录的 data 文件夹；启用主密码后以 ea$ 密文落盘。" /><LineBreak /><LineBreak />
                            <Run Text="• 修补希沃白板需要管理员权限，可在应用内随时撤销。" /><LineBreak /><LineBreak />
                            <Run Text="• 除检查更新外不联网，不做任何遥测上报。" /><LineBreak /><LineBreak />
                            <Run Text="• 修改、分发须遵守 GPLv3，并保留上游 EasiAuto（作者 hxabcd）的来源声明。" />
                        </TextBlock>
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <TextBlock Text="安装到" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TargetDirectoryBox" Grid.Column="0" Padding="8,6" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Content="浏览…" Padding="14,6" Margin="8,0,0,0" Click="OnBrowseClicked" />
                    </Grid>
                    <TextBlock Opacity="0.6" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="默认安装到当前用户目录，无需管理员权限。升级安装会覆盖程序文件，保留 data 中的数据。" />
                </StackPanel>
            </Grid>

            <!-- 第 2 步：选项 -->
            <Grid x:Name="OptionsStep" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="安装选项" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <CheckBox x:Name="DesktopShortcutCheck" Content="创建桌面快捷方式" IsChecked="True" Margin="0,0,0,10" />
                    <CheckBox x:Name="StartMenuShortcutCheck" Content="创建开始菜单快捷方式" IsChecked="True" Margin="0,0,0,10" />
                    <CheckBox x:Name="LaunchCheck" Content="安装完成后启动 EasiLoginer" IsChecked="True" Margin="0,0,0,10" />

                    <TextBlock Opacity="0.65" Margin="0,14,0,0" TextWrapping="Wrap"
                               Text="登录方式、主题等设置可在首次启动的向导中完成；也可以稍后在配置页修改。" />
                </StackPanel>
            </Grid>

            <!-- 第 3 步：进度 -->
            <Grid x:Name="ProgressStep" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ProgressTitle" Text="正在安装…" FontSize="17" FontWeight="SemiBold" />
                    <ProgressBar x:Name="InstallProgressBar" Height="10" Margin="0,16,0,0" Minimum="0" Maximum="100" />
                    <TextBlock x:Name="ProgressDetail" Opacity="0.7" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <!-- 完成 -->
            <Grid x:Name="FinishStep" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="FinishTitle" Text="安装完成" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock x:Name="FinishDetail" Opacity="0.75" Margin="0,10,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Opacity="0.6" TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackButton" Content="上一步" Padding="18,6" Margin="0,0,8,0" Click="OnBackClicked" />
                <Button x:Name="NextButton" Content="下一步" Padding="22,6" Margin="0,0,8,0" Click="OnNextClicked" />
                <Button x:Name="CancelButton" Content="取消" Padding="18,6" Click="OnCancelClicked" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
