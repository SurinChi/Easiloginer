<ui:FluentWindow x:Class="EasiLoginer.Presentation.Login.PreRunConfirmWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="确认运行登录"
                 Width="520" SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="确认运行登录" ShowMaximize="False" ShowMinimize="False" ShowClose="False" />

        <StackPanel Grid.Row="1" Margin="24,8,24,20">
            <TextBlock x:Name="AccountText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="即将启动希沃白板并自动登录，请确认当前没有正在进行的重要操作。"
                       TextWrapping="Wrap" Opacity="0.85" Margin="0,10,0,0" />
            <TextBlock x:Name="CountdownText" Margin="0,14,0,0" Opacity="0.75" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="取消" Padding="18,6" Margin="0,0,8,0" Click="OnCancelClicked" />
                <Button Content="推迟" Padding="18,6" Margin="0,0,8,0" Click="OnDelayClicked" />
                <Button Content="立即执行" Padding="20,6" Click="OnProceedClicked" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
