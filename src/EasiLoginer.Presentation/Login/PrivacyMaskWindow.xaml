<Window x:Class="EasiLoginer.Presentation.Login.PrivacyMaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="White"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SizeToContent="Manual">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="正在登录" FontSize="22" FontWeight="SemiBold"
                   Foreground="#FF202020" HorizontalAlignment="Center" />
        <TextBlock Text="已启用隐私保护，请勿操作"
                   Foreground="#FF6A6A6A" Margin="0,8,0,0" HorizontalAlignment="Center" />
    </StackPanel>
</Window>
