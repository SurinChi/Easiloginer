<Window x:Class="EasiLoginer.Presentation.Installer.InstallWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasiLoginer 安装向导"
        Width="580" Height="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F7F7F8"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        TextElement.Foreground="#1B1B1F">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Border Width="44" Height="44" CornerRadius="8" Background="#1DB954">
                <TextBlock Text="EL" Foreground="White" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="EasiLoginer 安装向导" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="SubtitleText" Opacity="0.7" Margin="0,3,0,0"
                           Text="选择安装位置后点击「安装」" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,22,0,0">
            <TextBlock Text="安装到" FontWeight="SemiBold" Margin="0,0,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TargetDirectoryBox" Grid.Column="0" Padding="8,6" VerticalContentAlignment="Center" />
                <Button Grid.Column="1" Content="浏览…" Padding="14,6" Margin="8,0,0,0" Click="OnBrowseClicked" />
            </Grid>
            <TextBlock Opacity="0.6" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="默认安装到当前用户目录，无需管理员权限。升级安装会覆盖程序文件并保留 data 目录。" />

            <CheckBox x:Name="DesktopShortcutCheck" Content="创建桌面快捷方式" IsChecked="True" Margin="0,16,0,0" />
            <CheckBox x:Name="StartMenuShortcutCheck" Content="创建开始菜单快捷方式" IsChecked="True" Margin="0,10,0,0" />
            <CheckBox x:Name="LaunchCheck" Content="安装完成后启动 EasiLoginer" IsChecked="True" Margin="0,10,0,0" />

            <ProgressBar x:Name="InstallProgressBar" Height="8" Margin="0,22,0,0" Minimum="0" Maximum="100" />
            <TextBlock x:Name="StatusText" Opacity="0.7" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Content="取消" Padding="20,7" Margin="0,0,8,0" Click="OnCancelClicked" />
            <Button x:Name="InstallButton" Content="安装" Padding="24,7" FontWeight="SemiBold"
                    Background="#107C10" Foreground="White" BorderBrush="#0B5C0B" Click="OnInstallClicked" />
        </StackPanel>
    </Grid>
</Window>
