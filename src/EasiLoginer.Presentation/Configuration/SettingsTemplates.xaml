<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:config="clr-namespace:EasiLoginer.Presentation.Configuration">

    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <!-- 设置卡片模板：配置页与更新页共用 -->
    <DataTemplate x:Key="SettingsGroupTemplate" DataType="{x:Type config:SettingsGroupViewModel}">
        <Border Margin="0,0,0,16" Padding="16" CornerRadius="8"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type config:SettingItemViewModel}">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextWrapping="Wrap" />

                                <Grid Grid.Column="1">
                                    <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                              Visibility="{Binding IsBool, Converter={StaticResource BoolToVis}}" />

                                    <ComboBox ItemsSource="{Binding Options}"
                                              SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                                              Visibility="{Binding IsEnum, Converter={StaticResource BoolToVis}}" />

                                    <TextBox Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding IsTextual, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>
