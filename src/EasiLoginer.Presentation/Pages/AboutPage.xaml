<Page x:Class="EasiLoginer.Presentation.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="关于"
      TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" Padding="24">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <!-- 大横幅：与 README 共用同一张图 -->
            <Border x:Name="BannerBorder" Height="300" Margin="0,0,0,22" CornerRadius="16"
                    SizeChanged="OnBannerSizeChanged">
                <Border.Background>
                    <ImageBrush ImageSource="pack://application:,,,/EasiLoginer.Presentation;component/Assets/banner.png"
                                Stretch="UniformToFill" />
                </Border.Background>
            </Border>

            <!-- 作者信息前置：头像、名字、官网 -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="96" Height="96" CornerRadius="24" Margin="0,0,18,0">
                    <Border.Background>
                        <ImageBrush ImageSource="pack://application:,,,/EasiLoginer.Presentation;component/Assets/author.png"
                                    Stretch="UniformToFill" />
                    </Border.Background>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="SurinChi" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="EasiLoginer 作者 · 独立开发者" Opacity="0.65" Margin="0,2,0,0" />
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                        <Hyperlink NavigateUri="https://surinchi.github.io" RequestNavigate="OnLinkNavigate">
                            surinchi.github.io
                        </Hyperlink>
                        <Run Text="   ·   " />
                        <Hyperlink NavigateUri="https://github.com/SurinChi" RequestNavigate="OnLinkNavigate">
                            GitHub
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>

                <TextBlock x:Name="VersionText" Grid.Column="2" VerticalAlignment="Top"
                           HorizontalAlignment="Right" Opacity="0.65" />
            </Grid>

            <TextBlock FontSize="16" LineHeight="26" TextWrapping="Wrap" Margin="0,0,0,4"
                       Text="一个手动触发的希沃白板自动登录工具：点一下，它替你启动、填账号、点登录。不驻留后台，也不会自动执行。" />

            <!-- 只保留四点亮点，避免像说明书 -->
            <UniformGrid Columns="2" Margin="0,18,0,0">
                <Border Margin="0,0,10,10" Padding="16" CornerRadius="10"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Flash24" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="手动触发" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="只在你点击时执行，不驻留后台，也不监控事件。"
                                   Opacity="0.7" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Margin="10,0,0,10" Padding="16" CornerRadius="10"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Person24" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="四种登录方式" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="自动定位默认最稳，另有固定位置、图像识别与令牌投递。"
                                   Opacity="0.7" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Margin="0,10,10,0" Padding="16" CornerRadius="10"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Password24" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="多档案与加密" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="多个账号各自成档；可选主密码，账号密码以 ea$ 密文落盘。"
                                   Opacity="0.7" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Margin="10,10,0,0" Padding="16" CornerRadius="10"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Shield24" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="本地优先" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="无账号体系、无遥测；仅检查更新与拉取公告时联网。"
                                   Opacity="0.7" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Margin="0,6,0,0" Opacity="0.7" TextWrapping="Wrap"
                       Text="外观支持亚克力毛玻璃与自定义背景；超时、遮罩、横幅、状态浮窗等都能在设置页调整。" />

            <WrapPanel Margin="0,20,0,0">
                <Button x:Name="AgreementButton" Content="用户协议" Padding="18,6"
                        Click="OnAgreementClicked" />
                <TextBlock VerticalAlignment="Center" Margin="18,0,0,0" Opacity="0.5" Text="·" />
                <TextBlock VerticalAlignment="Center" Margin="18,0,0,0">
                    <Hyperlink NavigateUri="https://github.com/SurinChi/Easiloginer" RequestNavigate="OnLinkNavigate">
                        项目主页
                    </Hyperlink>
                </TextBlock>
                <TextBlock VerticalAlignment="Center" Margin="18,0,0,0" Opacity="0.5" Text="·" />
                <TextBlock VerticalAlignment="Center" Margin="18,0,0,0">
                    <Hyperlink NavigateUri="https://github.com/SurinChi/Easiloginer/issues" RequestNavigate="OnLinkNavigate">
                        问题反馈
                    </Hyperlink>
                </TextBlock>
            </WrapPanel>

            <TextBlock Margin="0,22,0,0" Opacity="0.55" TextWrapping="Wrap"
                       Text="GPLv3 · Copyright (C) 2026 SurinChi · 基于上游 EasiAuto（hxabcd）用 C# / WPF 重写" />
        </StackPanel>
    </ScrollViewer>
</Page>
