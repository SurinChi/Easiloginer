<Page x:Class="EasiLoginer.Presentation.Pages.ConfigPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:config="clr-namespace:EasiLoginer.Presentation.Configuration"
      Title="设置"
      TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/EasiLoginer.Presentation;component/Configuration/SettingsTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="按功能分类；修改后点击“保存”写入 config.json。数值越界会自动钳制到允许范围。"
                       Opacity="0.7" Margin="0,4,0,0" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
                <Button Content="保存" Padding="24,8" Click="OnSaveClicked" />
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="16,0,0,0" Opacity="0.85" />
            </StackPanel>
        </StackPanel>

        <!-- 顶部分类导航：登录 / 提醒与遮罩 / 应用与外观 -->
        <TabControl ItemsSource="{Binding Categories}"
                    SelectedIndex="{Binding SelectedCategoryIndex, Mode=TwoWay}"
                    Margin="0,4,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <!-- 让屏幕阅读器/UI 自动化读到分类标题，而不是视图模型的类型名 -->
                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                    <Setter Property="Margin" Value="0,0,8,0" />
                    <Setter Property="Padding" Value="14,7" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Root" CornerRadius="6"
                                        Background="Transparent"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background"
                                                Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Root" Property="Background"
                                                Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.ItemContainerStyle>
            <TabControl.ItemTemplate>
                <DataTemplate DataType="{x:Type config:SettingsCategoryViewModel}">
                    <TextBlock Text="{Binding Title}" FontSize="14" Margin="2,0" />
                </DataTemplate>
            </TabControl.ItemTemplate>

            <TabControl.ContentTemplate>
                <DataTemplate DataType="{x:Type config:SettingsCategoryViewModel}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly"
                                  Padding="0,12,8,0">
                        <ItemsControl ItemsSource="{Binding Groups}"
                                      ItemTemplate="{StaticResource SettingsGroupTemplate}" />
                    </ScrollViewer>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </DockPanel>
</Page>
