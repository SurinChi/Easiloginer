<Page x:Class="EasiLoginer.Presentation.Pages.ConfigPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:config="clr-namespace:EasiLoginer.Presentation.Configuration"
      Title="配置"
      TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="配置" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="修改后点击“保存”写入 config.json。数值越界会自动钳制到允许范围。"
                       Opacity="0.7" Margin="0,4,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="保存" Padding="24,8" Click="OnSaveClicked" />
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="16,0,0,0" Opacity="0.85" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type config:SettingsGroupViewModel}">
                        <Border Margin="0,0,0,16" Padding="16" CornerRadius="8"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type config:SettingItemViewModel}">
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="240" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextWrapping="Wrap" />

                                                <Grid Grid.Column="1">
                                                    <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                                              Visibility="{Binding IsBool, Converter={StaticResource BoolToVis}}" />

                                                    <ComboBox ItemsSource="{Binding Options}"
                                                              SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                                                              Visibility="{Binding IsEnum, Converter={StaticResource BoolToVis}}" />

                                                    <TextBox Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Visibility="{Binding IsTextual, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Page>
