<Page x:Class="EasiLoginer.Presentation.Pages.ConfigPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:config="clr-namespace:EasiLoginer.Presentation.Configuration"
      Title="设置"
      TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/EasiLoginer.Presentation;component/Configuration/SettingsTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <DockPanel Margin="24">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="更改后请保存设置项，未保存的改动将不生效。"
                           Opacity="0.7" Margin="0,4,0,0" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
                    <Button Content="保存" Padding="24,8" Click="OnSaveClicked" />
                    <Button Content="重置全部" Padding="18,8" Margin="8,0,0,0" Click="OnResetAllClicked" />
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="16,0,0,0" Opacity="0.85" />
                </StackPanel>
            </StackPanel>

            <!-- 顶部分类导航：登录 / 提醒与遮罩 / 应用与外观 -->
            <TabControl ItemsSource="{Binding Categories}"
                        SelectedIndex="{Binding SelectedCategoryIndex, Mode=TwoWay}"
                        Margin="0,4,0,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <!-- 让屏幕阅读器/UI 自动化读到分类标题，而不是视图模型的类型名 -->
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                        <Setter Property="Margin" Value="0,0,8,0" />
                        <Setter Property="Padding" Value="14,7" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="Root" CornerRadius="6"
                                            Background="Transparent"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Background"
                                                    Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Root" Property="Background"
                                                    Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.ItemContainerStyle>
                <TabControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type config:SettingsCategoryViewModel}">
                        <TextBlock Text="{Binding Title}" FontSize="14" Margin="2,0" />
                    </DataTemplate>
                </TabControl.ItemTemplate>

                <TabControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type config:SettingsCategoryViewModel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                          PanningMode="VerticalOnly" Padding="0,12,8,0">
                                <ItemsControl ItemsSource="{Binding Groups}"
                                              ItemTemplate="{StaticResource SettingsGroupTemplate}" />
                            </ScrollViewer>

                            <Button Grid.Row="1" Content="重置本页" Padding="18,7"
                                    HorizontalAlignment="Left" Margin="0,12,0,0"
                                    Click="OnResetPageClicked" />
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </DockPanel>

        <!-- 未保存改动的悬浮提示：左下角，带快捷保存 -->
        <Border Panel.ZIndex="10" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="24" Padding="16,10" CornerRadius="10"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibility}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.25" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="保存后设置项生效" VerticalAlignment="Center" FontWeight="SemiBold" />
                <Button Content="保存" Padding="16,5" Margin="16,0,0,0" Click="OnSaveClicked" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
