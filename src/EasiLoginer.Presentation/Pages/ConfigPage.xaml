<Page x:Class="EasiLoginer.Presentation.Pages.ConfigPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:config="clr-namespace:EasiLoginer.Presentation.Configuration"
      Title="配置"
      TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/EasiLoginer.Presentation;component/Configuration/SettingsTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="配置" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="修改后点击“保存”写入 config.json。数值越界会自动钳制到允许范围。"
                       Opacity="0.7" Margin="0,4,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="保存" Padding="24,8" Click="OnSaveClicked" />
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="16,0,0,0" Opacity="0.85" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}"
                          ItemTemplate="{StaticResource SettingsGroupTemplate}" />
        </ScrollViewer>
    </DockPanel>
</Page>
