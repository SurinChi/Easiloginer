<Page x:Class="EasiLoginer.Presentation.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="档案"
      TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="档案" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Text="登录只能由你手动触发。" Opacity="0.7" Margin="0,0,0,10" />

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding EncryptionStatus}" VerticalAlignment="Center" Margin="0,0,16,0" Opacity="0.85" />
                <Button Content="启用加密" Padding="16,6" Margin="0,0,8,0"
                        IsEnabled="{Binding CanEnableEncryption}" Click="OnEnableEncryptionClicked" />
                <Button Content="解锁" Padding="16,6" Margin="0,0,8,0"
                        IsEnabled="{Binding CanUnlock}" Click="OnUnlockClicked" />
                <Button Content="关闭加密" Padding="16,6"
                        IsEnabled="{Binding CanDisableEncryption}" Click="OnDisableEncryptionClicked" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <ListBox Height="340"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding Selected, Mode=TwoWay}"
                         DisplayMemberPath="DisplayLabel" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="添加" Padding="18,6" Click="OnAddClicked" />
                    <Button Content="删除" Padding="18,6" Margin="8,0,0,0" Click="OnDeleteClicked" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="24,0,0,0" IsEnabled="{Binding HasSelection}">
                <TextBlock Text="名称" FontWeight="SemiBold" Margin="0,4,0,4" />
                <TextBox Text="{Binding Selected.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="账号" FontWeight="SemiBold" Margin="0,12,0,4" />
                <TextBox Text="{Binding Selected.Account, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="密码" FontWeight="SemiBold" Margin="0,12,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <PasswordBox x:Name="PasswordInput" PasswordChar="●"
                                     PasswordChanged="OnPasswordChanged" />
                        <TextBox x:Name="PasswordPlain" Visibility="Collapsed"
                                 TextChanged="OnPlainTextChanged" />
                    </Grid>

                    <Button x:Name="RevealButton" Grid.Column="1" Content="👁" Padding="12,0"
                            Margin="8,0,0,0" ToolTip="显示密码" Click="OnRevealClicked" />
                </Grid>

                <TextBlock Text="密码默认以圆点显示，点右侧眼睛可临时查看。启用主密码加密后，账号与密码以 ea$ 密文落盘。"
                           Opacity="0.7" Margin="0,8,0,0" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button Content="保存档案" Padding="18,6" Click="OnSaveClicked" />
                    <Button Content="运行登录" Padding="18,6" Margin="8,0,0,0" Click="OnRunClicked" />
                </StackPanel>

                <TextBlock Text="{Binding StatusText}" Margin="0,12,0,0" Opacity="0.85" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
