<Page x:Class="EasiLoginer.Presentation.Pages.AnnouncementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="公告"
      TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" Padding="24">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="公告" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="版本更新、维护通知与使用须知。公告由项目仓库统一发布，不需要重新安装应用。"
                       Opacity="0.7" Margin="0,4,0,0" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Margin="0,14,0,4">
                <Button x:Name="RefreshButton" Content="刷新公告" Padding="18,6" Click="OnRefreshClicked" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="14,0,0,0"
                           Opacity="0.7" Text="正在获取公告…" />
            </StackPanel>

            <TextBlock x:Name="EmptyText" Visibility="Collapsed" Margin="0,28,0,0"
                       Opacity="0.65" TextWrapping="Wrap"
                       Text="暂时没有公告。发布新版本或维护通知后，这里会自动出现。" />

            <ItemsControl x:Name="ItemsHost" Margin="0,14,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,12" Padding="18" CornerRadius="10"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="4" CornerRadius="2" Margin="0,2,12,2"
                                            Background="{Binding Accent}" />
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="17"
                                               TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Text="{Binding Body}" TextWrapping="Wrap" Opacity="0.88"
                                           Margin="16,8,0,0" LineHeight="22" />

                                <Button Content="查看详情" Padding="12,4" Margin="16,12,0,0"
                                        HorizontalAlignment="Left" Tag="{Binding Url}"
                                        Visibility="{Binding HasLink, Converter={StaticResource BoolToVisibility}}"
                                        Click="OnOpenLinkClicked" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
