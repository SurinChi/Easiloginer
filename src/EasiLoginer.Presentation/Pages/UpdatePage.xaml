<Page x:Class="EasiLoginer.Presentation.Pages.UpdatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="更新"
      TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <StackPanel Margin="24">
        <TextBlock Text="更新" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock x:Name="VersionText" Opacity="0.75" Margin="0,0,0,16" />

        <TextBlock TextWrapping="Wrap" Opacity="0.85"
                   Text="EasiLoginer 只读取自己的更新清单，不会使用上游 EasiAuto 的清单或资产。首发版本未配置更新源，你可以手动下载新版本压缩包覆盖（数据和配置在 data 目录，不会被覆盖）。" />

        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
            <Button x:Name="CheckButton" Content="检查更新" Padding="18,6" Click="OnCheckClicked" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="14,0,0,0" Opacity="0.85" TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Text="更新通道与模式可在配置页的「更新」分组调整。" Opacity="0.65" Margin="0,16,0,0" />
    </StackPanel>
</Page>
