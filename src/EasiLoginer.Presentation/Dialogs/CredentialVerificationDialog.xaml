<ui:FluentWindow x:Class="EasiLoginer.Presentation.Dialogs.CredentialVerificationDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="500" SizeToContent="Height"
                 Title="请选择验证方式"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="Header" Title="请选择验证方式"
                     ShowMaximize="False" ShowMinimize="False" ShowClose="True" />

        <StackPanel Grid.Row="1" Margin="20,8,20,20">
            <TextBlock Text="该操作涉及账号与密码，请选择一种方式验证。"
                       TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,12" />

            <TabControl x:Name="MethodTabs" SelectionChanged="OnMethodChanged"
                        Background="Transparent" BorderThickness="0" Padding="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Foreground"
                                Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Setter Property="Margin" Value="0,0,8,0" />
                        <Setter Property="Padding" Value="16,8" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="TabButton" CornerRadius="6"
                                            Background="Transparent"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter ContentSource="Header"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TabButton" Property="Background"
                                                    Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="TabButton" Property="Background"
                                                    Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.4" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <TabItem Header="验证主密码">
                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="主密码" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <PasswordBox x:Name="MasterPasswordInput" Padding="10,8" />
                    </StackPanel>
                </TabItem>
                <TabItem x:Name="ProfilePasswordTab" Header="验证原密码">
                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="当前档案的原密码" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <PasswordBox x:Name="ProfilePasswordInput" Padding="10,8" />
                    </StackPanel>
                </TabItem>
            </TabControl>

            <TextBlock x:Name="ErrorText" Foreground="#FFD13438" TextWrapping="Wrap" Margin="0,10,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="取消" Padding="18,6" Margin="0,0,8,0" Click="OnCancelClicked" />
                <Button Content="确定" Padding="18,6" Click="OnConfirmClicked" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
