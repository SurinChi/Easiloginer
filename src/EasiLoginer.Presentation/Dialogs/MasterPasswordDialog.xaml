<ui:FluentWindow x:Class="EasiLoginer.Presentation.Dialogs.MasterPasswordDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="440" SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="Header" ShowMaximize="False" ShowMinimize="False" ShowClose="True" />

        <StackPanel Grid.Row="1" Margin="20,8,20,20">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,12" />

            <TextBlock Text="主密码" FontWeight="SemiBold" Margin="0,0,0,4" />
            <PasswordBox x:Name="PasswordInput" Padding="10,8" PasswordChanged="OnPasswordChanged" />

            <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed" Margin="0,12,0,0">
                <TextBlock Text="确认主密码" FontWeight="SemiBold" Margin="0,0,0,4" />
                <PasswordBox x:Name="ConfirmInput" Padding="10,8" PasswordChanged="OnPasswordChanged" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" Foreground="#FFD13438" TextWrapping="Wrap" Margin="0,10,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="取消" Padding="18,6" Margin="0,0,8,0" Click="OnCancelClicked" />
                <Button Content="确定" Padding="18,6" Click="OnConfirmClicked" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
