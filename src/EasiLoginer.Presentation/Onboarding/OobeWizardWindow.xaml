<ui:FluentWindow x:Class="EasiLoginer.Presentation.Onboarding.OobeWizardWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="EasiLoginer 首次设置"
                 Width="720" Height="520"
                 MinWidth="640" MinHeight="460"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="EasiLoginer 首次设置"
                     ShowMaximize="False" ShowMinimize="False" ShowClose="True" />

        <Grid Grid.Row="1" Margin="28,8,28,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock x:Name="StepTitle" FontSize="24" FontWeight="SemiBold" />
                <TextBlock x:Name="StepProgress" Opacity="0.7" Margin="0,4,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="StepContent" />
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2" Margin="28,16,28,20">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Opacity="0.75" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SkipButton" Content="跳过向导" Padding="16,6" Margin="0,0,8,0" Click="OnSkipClicked" />
                <Button x:Name="PreviousButton" Content="上一步" Padding="16,6" Margin="0,0,8,0" Click="OnPreviousClicked" />
                <Button x:Name="NextButton" Content="下一步" Padding="20,6" Click="OnNextClicked" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
